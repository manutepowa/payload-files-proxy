{
  "name": "payload-files-proxy",
  "version": "1.0.8",
  "description": "Plugin to getting production files on a development server on demand.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "typescript",
    "react",
    "payload-plugin"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev",
    "dev:generate-importmap": "cross-env TSX_TSCONFIG_PATH=./dev/tsconfig.json pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.92.0",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@swc-node/register": "1.10.10",
    "@swc/cli": "0.7.7",
    "@types/node": "^22.5.4",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "graphql": "^16.8.1",
    "next": "15.4.11",
    "open": "^10.1.0",
    "payload": "3.92.0",
    "prettier": "^3.4.2",
    "qs-esm": "7.0.2",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "rimraf": "3.0.2",
    "sharp": "0.32.6",
    "sort-package-json": "^2.10.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "payload": "^3.92.0"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^11"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "packageManager": "pnpm@11.25.0",
  "registry": "https://registry.npmjs.org/"
}
